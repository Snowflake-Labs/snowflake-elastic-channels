# Rendered by infra/eks/run_job.sh (envsubst) for each run. One pod per
# worker (Indexed Job -> stable JOB_COMPLETION_INDEX per pod, used as the
# worker id in k8s_worker.py). Fixed-throughput only (no cross-pod
# coordination for dynamic ramp tiers) — see k8s_worker.py module docstring.
apiVersion: batch/v1
kind: Job
metadata:
  name: elastic-ramp-${RUN_ID}
  namespace: elastic-ramp
  labels:
    app: elastic-ramp-worker
    run-id: "${RUN_ID}"
spec:
  completionMode: Indexed
  parallelism: ${WORKER_COUNT}
  completions: ${WORKER_COUNT}
  backoffLimitPerIndex: 1
  activeDeadlineSeconds: ${ACTIVE_DEADLINE_SECONDS}
  template:
    metadata:
      labels:
        app: elastic-ramp-worker
        run-id: "${RUN_ID}"
    spec:
      restartPolicy: Never
      terminationGracePeriodSeconds: 90
      nodeSelector:
        role: elastic-ramp-worker
      tolerations:
        - key: workload
          operator: Equal
          value: elastic-ramp-worker
          effect: NoSchedule
      containers:
        - name: worker
          image: ${IMAGE_URI}
          # build_and_push.sh tags by git SHA, which doesn't change between local
          # edits without a commit — Always ensures the digest is re-checked and
          # pulled even when the tag is unchanged (IfNotPresent would serve a
          # node's stale cached layer for that tag).
          imagePullPolicy: Always
          command: ["python3", "src/elastic_channels/k8s_worker.py"]
          envFrom:
            - secretRef:
                name: snowflake-credentials
          env:
            - name: ELASTIC_RUN_ID
              value: "${RUN_ID}"
            - name: ELASTIC_WORKER_TARGET_BPS
              value: "${WORKER_TARGET_BPS}"
            - name: ELASTIC_DURATION_SECONDS
              value: "${DURATION_SECONDS}"
            - name: ELASTIC_MAX_BATCH_ROWS
              value: "${MAX_BATCH_ROWS}"
            - name: ELASTIC_TARGET_BATCH_BYTES
              value: "${TARGET_BATCH_BYTES}"
            - name: ELASTIC_MAX_IN_FLIGHT
              value: "${MAX_IN_FLIGHT}"
            - name: ELASTIC_WORKERS_TOTAL
              value: "${WORKER_COUNT}"
            - name: ELASTIC_PIPE_NAME
              value: "${PIPE_NAME}"
            - name: ELASTIC_FAST_JSON_ENCODE
              value: "${FAST_JSON_ENCODE}"
            - name: ELASTIC_WORKER_REPORT_INTERVAL_SECONDS
              value: "5"
            - name: ELASTIC_WORKER_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.annotations['batch.kubernetes.io/job-completion-index']
          resources:
            requests:
              cpu: "${WORKER_CPU_REQUEST}"
              memory: "${WORKER_MEMORY_REQUEST}"
            limits:
              cpu: "${WORKER_CPU_REQUEST}"
              memory: "${WORKER_MEMORY_REQUEST}"
