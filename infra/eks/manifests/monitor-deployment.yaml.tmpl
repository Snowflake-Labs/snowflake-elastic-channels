# Rendered by infra/eks/deploy_monitor.sh (envsubst). Single long-lived
# replica — created once per cluster, watches every run's worker pods by
# label rather than being redeployed per run (see k8s_monitor.py docstring).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: elastic-monitor
  namespace: elastic-ramp
  labels:
    app: elastic-monitor
spec:
  replicas: 1
  selector:
    matchLabels:
      app: elastic-monitor
  template:
    metadata:
      labels:
        app: elastic-monitor
    spec:
      serviceAccountName: elastic-monitor
      nodeSelector:
        role: system
      restartPolicy: Always
      containers:
        - name: monitor
          image: ${IMAGE_URI}
          imagePullPolicy: Always
          command: ["python3", "src/elastic_channels/k8s_monitor.py"]
          envFrom:
            - secretRef:
                name: snowflake-credentials
          env:
            - name: ELASTIC_NAMESPACE
              value: "elastic-ramp"
            - name: ELASTIC_WORKER_LABEL_SELECTOR
              value: "app=elastic-ramp-worker"
            - name: ELASTIC_MONITOR_POLL_SECONDS
              value: "10"
            - name: ELASTIC_MONITOR_FLUSH_SECONDS
              value: "30"
            - name: ELASTIC_MONITOR_COMMIT_LATENCY_SECONDS
              value: "120"
            - name: ELASTIC_K8S_METRICS_TABLE
              value: "ELASTIC_K8S_METRICS"
          resources:
            requests:
              cpu: "500m"
              memory: "1Gi"
            limits:
              cpu: "1"
              memory: "2Gi"
