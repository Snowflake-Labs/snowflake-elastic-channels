# Snowflake connection (local dev and setup scripts). Never commit real
# values. This same set of vars is what infra/eks/create_secret.sh reads to
# populate the `snowflake-credentials` Kubernetes Secret consumed by
# worker/monitor pods (see src/elastic_channels/auth.py).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Key-pair auth (required for EKS workers/monitor; PEM contents or path to .p8 file)
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PATH=
# Warehouse used to run setup DDL (needs appropriate privileges); falls back
# to SNOWFLAKE_WAREHOUSE if unset
SNOWFLAKE_ADMIN_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Streamlit app query warehouse (snowflake.yml query_warehouse)
SNOWFLAKE_STREAMLIT_WAREHOUSE=LARGE_WH
# Streamlit query caps for multi-billion-row RESORT_SALES (requires LARGE_WH+ at 30s timeout)
# ELASTIC_RAMP_QUERY_MAX_WINDOW_MINUTES=10
# ELASTIC_RAMP_WORKER_MAX_WINDOW_MINUTES=5
# ELASTIC_RAMP_LATENCY_MAX_WINDOW_MINUTES=10

# Elastic channel benchmark objects (scripts/setup_elastic_ramp.py)
ELASTIC_TABLE_NAME=RESORT_SALES
ELASTIC_PIPE_NAME=RESORT_SALES_PIPE
# Network: setup writes ELASTIC_RAMP_INGRESS + ELASTIC_RAMP_POLICY only.
# Attach with --attach-network-policy=user|account (account requires the
# --i-understand-this-replaces-the-account-network-policy flag).

# EKS worker/monitor runtime settings below are normally injected per-run by
# infra/eks/run_job.sh / deploy_monitor.sh (envsubst into the Job/Deployment
# manifests), not read from .env directly — listed here for reference and for
# any local single-worker testing (`python -m elastic_channels.k8s_worker`).
# ELASTIC_RUN_ID=local-test
# ELASTIC_WORKER_TARGET_BPS=1000000     # per-worker target bytes/sec
# ELASTIC_DURATION_SECONDS=600
# ELASTIC_MAX_BATCH_ROWS=40000
# ELASTIC_TARGET_BATCH_BYTES=2097152
# ELASTIC_MAX_IN_FLIGHT=64
# ELASTIC_SDK_METRICS_PORT=9090
# ELASTIC_WORKER_ID=0                   # local-only fallback; EKS uses JOB_COMPLETION_INDEX
# JSON fast-path: pre-encode NDJSON ourselves (native Rust wheel if installed,
# else msgspec) and append via the elastic channel's FFI directly, skipping
# the SDK's own dict->JSON re-encode (see fast_append.py). On by default;
# falls back automatically to msgspec when the native wheel isn't installed.
# ELASTIC_FAST_JSON_ENCODE=true

# Monitor-only settings (infra/eks/manifests/monitor-deployment.yaml.tmpl)
# ELASTIC_NAMESPACE=elastic-ramp
# ELASTIC_MONITOR_POLL_SECONDS=10
# ELASTIC_MONITOR_FLUSH_SECONDS=30
# ELASTIC_MONITOR_COMMIT_LATENCY_SECONDS=120
# ELASTIC_K8S_METRICS_TABLE=ELASTIC_K8S_METRICS
